---
/**
 * The first frame of the hero, and the picture whenever there is no live scene: before the
 * first interaction, under reduced motion, without WebGL, with Save-Data, or after a
 * failure. It is projected at build time from the same scene model, camera and shading as
 * the live scene at scroll position 0 (src/lib/scene-model.ts, src/lib/poster.ts), so the
 * switch to 3D shows no jump. Decorative: the text beside it carries the story and numbers.
 */
import { POSTER } from '../lib/scene-model.ts';
import { posterMarkup } from '../lib/poster.ts';
import type { HeroRung } from '../lib/example.ts';

interface Props {
  rungs: HeroRung[];
}
const { rungs } = Astro.props;
const permille = Object.fromEntries(rungs.map((r) => [r.id, r.permille])) as Record<
  'floor' | 'target' | 'opening',
  number
>;
const markup = posterMarkup(permille);
---

<svg
  class="poster"
  viewBox={`0 0 ${POSTER.w} ${POSTER.h}`}
  preserveAspectRatio="xMidYMid meet"
  role="presentation"
  focusable="false"
  set:html={markup}
/>
