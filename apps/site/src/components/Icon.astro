---
/**
 * The showcase's pillar icons: one set, 24 px grid, one stroke weight (1.6), round ends,
 * coloured by the surrounding text colour (a token). Decorative: the heading beside each
 * icon says the same thing in words.
 */
interface Props {
  name: 'exact' | 'label' | 'device' | 'practise';
}
const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'exact' && (
      <>
        {/* a calculator: a display above two rows of keys, the bottom right an equals sign */}
        <rect x="4.5" y="2.5" width="15" height="19" rx="3" />
        <rect x="7.5" y="5.5" width="9" height="4" rx="1" />
        <path d="M8 13.5h1.5M11.25 13.5h1.5M14.5 13.5H16M8 17.5h1.5M11.25 17.5h1.5M14.5 16.75H16M14.5 18.25H16" />
      </>
    )
  }
  {
    name === 'label' && (
      <>
        {/* a tag with a tick: every number carries its label */}
        <path d="M3.5 4.75v6.1a1.5 1.5 0 0 0 .44 1.06l8.15 8.15a1.5 1.5 0 0 0 2.12 0l5.83-5.83a1.5 1.5 0 0 0 0-2.12L11.9 3.96a1.5 1.5 0 0 0-1.06-.44H4.75A1.25 1.25 0 0 0 3.5 4.75z" />
        <circle cx="7.75" cy="7.75" r="1.25" />
        <path d="M10.5 13.25l1.75 1.75 3.5-3.5" />
      </>
    )
  }
  {
    name === 'device' && (
      <>
        {/* a phone with a lock: it stays on your device */}
        <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
        <rect x="9.25" y="11" width="5.5" height="4.5" rx="1" />
        <path d="M10.5 11V9.75a1.5 1.5 0 0 1 3 0V11M11 18.5h2" />
      </>
    )
  }
  {
    name === 'practise' && (
      <>
        {/* two speech bubbles: a rehearsed exchange */}
        <path d="M4.5 4h8a2 2 0 0 1 2 2v4.5a2 2 0 0 1-2 2H8.5l-3 2.75V12.5h-1a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
        <path d="M17 8.5h2.5a2 2 0 0 1 2 2V15a2 2 0 0 1-2 2h-1v2.75l-3-2.75H12.5a2 2 0 0 1-2-2v-.5" />
      </>
    )
  }
</svg>
